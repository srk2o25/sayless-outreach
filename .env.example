# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=cadence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cadence
POSTGRES_PORT=5432

# ── n8n ───────────────────────────────────────────────────────────────────
N8N_PORT=5678
N8N_ENCRYPTION_KEY=changeme-generate-a-real-32-char-key
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# ── Brevo ─────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDING_DOMAIN=cadence.sayless.ai

# ── linkedin-worker ───────────────────────────────────────────────────────
LINKEDIN_WORKER_PORT=4100
# Session is captured via one-time interactive login, not set here. See linkedin-worker/CLAUDE.md.

# ── admin-ui ──────────────────────────────────────────────────────────────
ADMIN_UI_PORT=4300
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook

# ── Rate governor (defaults — see docs/architecture.md for rationale) ─────
LI_DAILY_CONNECT_CAP=18
LI_WEEKLY_CONNECT_CAP=80
LI_DAILY_VISIT_CAP=40
LI_MIN_ACCEPT_RATE=0.15
EMAIL_DAILY_CAP_PER_INBOX=35
