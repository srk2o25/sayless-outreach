            "id": "ad89957357f3e9774fe7b759",
            "name": "Cadence Postgres"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "respond",
        "name": "Respond",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.5,
        "position": [440, 0],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $input.all().filter(i => Object.keys(i.json).length > 0).map(item => item.json) }}",
          "options": {}
        }
      }
    ],
    "connections": {
