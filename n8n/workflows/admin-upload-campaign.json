      {
        "id": "insert-campaign",
        "name": "Insert Campaign",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [660, 0],
        "parameters": {
          "resource": "database",
          "operation": "executeQuery",
          "query": "INSERT INTO campaigns (name, batch_filename, uploaded_by, row_count, status) VALUES ($1, $2, $3, $4, 'active') RETURNING id, name, batch_filename, uploaded_by, row_count, status, created_at",
          "options": {
            "queryReplacement": "={{ [$('Webhook').first().json.body.name, $('Webhook').first().binary.file.fileName, $('Webhook').first().json.body.uploadedBy ?? 'admin-ui', $('Collect Rows').first().json.rows.length] }}"
          }
        },
        "credentials": {
          "postgres": { "id": "ad89957357f3e9774fe7b759", "name": "Cadence Postgres" }
        }
      },
      {
        "id": "clone-default-sequence",
        "name": "Clone Default Sequence",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [880, 0],
        "parameters": {
          "resource": "database",
          "operation": "executeQuery",
          "query": "INSERT INTO sequence_steps (campaign_id, step_order, name, action_type, trigger_type, delay_interval, event_condition, enabled) SELECT $1::int, step_order, name, action_type, trigger_type, delay_interval, event_condition, enabled FROM sequence_steps WHERE campaign_id IS NULL",
          "options": {
            "queryReplacement": "={{ [$('Insert Campaign').first().json.id] }}"
          }
        },
        "credentials": {
          "postgres": { "id": "ad89957357f3e9774fe7b759", "name": "Cadence Postgres" }
        }
      },
      {
        "id": "build-prospect-rows",
        "name": "Build Prospect Rows",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1100, 0],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const campaignId = $('Insert Campaign').first().json.id;\nconst rows = $('Collect Rows').first().json.rows;\nreturn rows.map((r) => ({\n  json: {\n    campaign_id: campaignId,\n    full_name: r.full_name,\n    company: r.company ?? null,\n    email: r.email ?? null,\n    linkedin_url: r.linkedin_url ?? null,\n  },\n}));"
        }
      },
      {
        "id": "insert-prospects",
        "name": "Insert Prospects",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [1320, 0],
        "parameters": {
          "resource": "database",
          "operation": "executeQuery",
          "query": "INSERT INTO prospects (campaign_id, full_name, company, email, linkedin_url) VALUES ($1::int, $2, $3, $4, $5)",
          "options": {
            "queryReplacement": "={{ [$json.campaign_id, $json.full_name, $json.company, $json.email, $json.linkedin_url] }}",
            "queryBatching": "transaction"
          }
        },
        "credentials": {
          "postgres": { "id": "ad89957357f3e9774fe7b759", "name": "Cadence Postgres" }
        }
      },
      {
        "id": "build-response",
        "name": "Build Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [1540, 0],
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const campaign = $('Insert Campaign').first().json;\nreturn [{ json: { ...campaign, prospects_inserted: $input.all().length } }];"
        }
      },
      {
        "id": "respond",
        "name": "Respond",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.5,
        "position": [1760, 0],
        "parameters": { "respondWith": "firstIncomingItem", "options": {} }
      }
    ],
    "connections": {
