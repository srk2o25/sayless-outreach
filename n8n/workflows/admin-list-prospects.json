    "id": "cadcampaignprosp01",
    "name": "admin-list-prospects",
    "active": false,
    "nodes": [
      {
        "id": "wh-campaign-prospects",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "webhookId": "94e61fae-a5f0-4eee-ab85-cdda26c11e7e",
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": [
            "GET"
          ],
          "path": "prospects",
          "responseMode": "responseNode",
          "options": {}
        }
      },
      {
        "id": "pg-campaign-prospects",
        "name": "List Campaign Prospects",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          220,
          0
        ],
        "parameters": {
          "resource": "database",
          "operation": "executeQuery",
          "query": "SELECT p.id, p.campaign_id AS \"campaignId\", p.full_name AS \"fullName\", p.company, p.email, p.linkedin_url AS \"linkedinUrl\", s.name AS \"currentStepName\", s.step_order AS \"currentStepOrder\", p.status, p.halted, p.archived, e.last_event_at AS \"lastEventAt\" FROM prospects p LEFT JOIN sequence_steps s ON s.id = p.current_step_id LEFT JOIN LATERAL (SELECT MAX(occurred_at) AS last_event_at FROM events WHERE events.prospect_id = p.id) e ON true WHERE p.campaign_id = $1::int AND (p.archived = false OR $2::boolean = true) ORDER BY p.id",
          "options": {
            "queryReplacement": "={{ [Number($json.query.campaignId), $json.query.includeArchived === 'true'] }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "ad89957357f3e9774fe7b759",
            "name": "Cadence Postgres"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "respond",
        "name": "Respond",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.5,
        "position": [
          440,
          0
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $input.all().filter(i => Object.keys(i.json).length > 0).map(item => item.json) }}",
          "options": {}
        }
      }
    ],
